# Example only. Copy to .env for local or Compose deployment; never commit real secrets.
APP_ENV=production
PDF_ANNOTATIONS_ENABLED=false
APP_TIMEZONE=Asia/Shanghai
WEB_PORT=3100
# Optional local Node executable; startup also checks data/runtime/node/node.exe and PATH.
WEB_NODE_EXE=
# Read-only platform registration of independently bound CLI project archives.
# Configure fixed roots; browser requests select a key, never a filesystem path.
PROJECT_ARCHIVE_CATALOG_ENABLED=false
PROJECT_ARCHIVE_WRITE_ENABLED=false
PROJECT_ARCHIVE_WORKSPACES_JSON=[]
# Owner-selected new project directories and private repositories; disabled by default.
PROJECT_PROVISION_ENABLED=false
PROJECT_PROVISION_MANAGED_ROOT=
PROJECT_PROVISION_GITHUB_OWNER=
PROJECT_PROVISION_GITHUB_OWNER_ID=0
API_PORT=8100
NEXT_PUBLIC_API_BASE_PATH=/api/v1
NEXT_TELEMETRY_DISABLED=1
API_INTERNAL_URL=http://api:8000
DATABASE_URL=postgresql+psycopg://researchos:change-me@postgres:5432/researchos
POSTGRES_DB=researchos
POSTGRES_USER=researchos
POSTGRES_PASSWORD=
# Production requires distinct random SESSION_SECRET and CSRF_SECRET of at least 32 characters.
SESSION_SECRET=
SESSION_TTL_HOURS=168
CSRF_SECRET=
# Set a random token for first owner setup; clear it after setup if desired.
INITIAL_SETUP_TOKEN=
STORAGE_PROVIDER=local
LOCAL_STORAGE_ROOT=./data/attachments
MAX_UPLOAD_MB=100
MAX_PDF_PAGES=250
BACKUP_ROOT=./data/backups
LITERATURE_OPENALEX_CONTACT_EMAIL=
CROSSREF_CONTACT_EMAIL=
# Optional read-only credentials for official public repository metadata APIs.
# Public imports work anonymously; never send these tokens from browser code.
GITHUB_API_TOKEN=
# Optional already authenticated OS Git Credential Manager account. Never stores the token here.
GITHUB_GCM_ACCOUNT=
HUGGINGFACE_API_TOKEN=
LITERATURE_SEMANTIC_SCHOLAR_API_KEY=
LITERATURE_IEEE_API_KEY=
LITERATURE_SCOPUS_API_KEY=
LITERATURE_WOS_API_KEY=
ZOTERO_MODE=disabled
# local mode only when API process runs on the same host as Zotero Desktop
ZOTERO_LOCAL_API_URL=http://127.0.0.1:23119/api
# Read installed Ethereal Style's local publication cache, never its API credentials.
ZOTERO_STYLE_CACHE_ENABLED=false
# Optional Zotero data directory; blank discovers the single default local profile.
ZOTERO_STYLE_DATA_DIR=
# web mode for Compose/NAS/server; use a read-only key and keep it server-side
ZOTERO_WEB_API_KEY=
ZOTERO_WEB_LIBRARY_TYPE=user
ZOTERO_WEB_LIBRARY_ID=
AI_PROVIDER=disabled
# AI_PROVIDER=codex uses the logged-in local Codex account for paper analysis.
# Owner cloud scope and explicit paper submissions still apply.
# Runtime call deadline is independent of Codex account quota; the adapter watchdog adds 30s.
CODEX_PAPER_TIMEOUT_SECONDS=900
PAPER_READING_SKILLS_ROOT=./data/reading-skills/ieee-skills/skills
# Install/configure your own compatible skill and template before enabling AI.
ANALYTICAL_WRITER_SKILL_PATH=
ANALYTICAL_NOTE_TEMPLATE_PATH=
ANALYTICAL_NOTE_ROOT=./data/analytical-notes
# Enable only after publication recovery acceptance; never starts AI analysis.
CANONICAL_PUBLICATION_AUTO_RETRY=false
OPENAI_API_KEY=
OPENAI_MODEL=
# Codex code tasks run only on a host that has the registered workspaces and Codex auth.
# Example: [{"id":"research-code","name":"Research code","path":"E:\\ResearchCode","allowed_modes":["read_only","workspace_write"]}]
CODEX_PROVIDER=disabled
CODEX_MODEL=gpt-6-luna
CODEX_REASONING_EFFORT=max
CODEX_WORKSPACES_JSON=[]
# Readonly native skills/list is opt-in. Roots permit bounded SKILL.md hashes only.
# Install the maintained orchestration Skills with scripts/install_project_skills.py;
# add only the explicitly selected workspace's .agents/skills directory to these read roots.
SKILL_DISCOVERY_ENABLED=false
SKILL_DISCOVERY_ROOTS_JSON=[]
# Opt-in project planning; capability configuration never approves cloud transfer or a real job.
RESEARCH_PLANNING_ENABLED=false
# Explicit local root containing scientific-brainstorming and idea-evaluator; no whole-volume root.
RESEARCH_PLANNING_SKILLS_ROOT=
# Opt-in repository asset cache. Preview/approval required; no source-code execution.
REPOSITORY_ASSETS_ENABLED=false
PROJECT_SOURCE_WORKSPACES_ENABLED=false
REPOSITORY_ASSET_MAX_BYTES=268435456
REPOSITORY_ASSET_MAX_FILES=10000
CODEX_TASK_TIMEOUT_SECONDS=1800
# Follow the signed-in Codex account quota. LOCAL_LIMITS explicitly opts into a soft local cap.
CODEX_BUDGET_MODE=PROVIDER_QUOTA
# Used only in LOCAL_LIMITS; usage reporting is not the account's remaining quota.
CODEX_MAX_TOKENS_PER_TASK=100000
OLLAMA_BASE_URL=
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Historical Runner configuration: ADR0050 permanently blocks new local research execution.
# These fields cannot enable experiments, model runs, training, evaluation or simulation.
BASELINE_RUNNER_ENABLED=false
BASELINE_RUNNER_DOCKER_EXECUTABLE=
BASELINE_RUNNER_DOCKER_HOST=
BASELINE_RUNNER_IMAGE_ID=
BASELINE_RUNNER_DAEMON_ID=
BASELINE_RUNNER_ROOT=data/runner

# Local result intake does not submit or execute server jobs.
SERVER_RESULT_MAX_UPLOAD_MB=32
SERVER_RESULT_SERVER_ID=
# Optional shared receipt-origin key; same value on the configured lab server, never in result ZIPs.
RESEARCHOS_SERVER_RESULT_HMAC_KEY=

# Explicit selected-source suggestions and bounded file application; no research execution
CODE_CHANGES_ENABLED=false

# Professional writing is manual: preview, cloud approval and start are separate.
# Configure an absolute existing Skill root; no Skill installation is performed.
WRITING_ENABLED=false
WRITING_SKILLS_ROOT=
# Optional separate complete IEEE Skills package (ieee-writing plus _shared).
WRITING_IEEE_SKILLS_ROOT=

# Document-only builds: no local research model, experiment or simulation.
MANUSCRIPT_BUILDS_ENABLED=false
MANUSCRIPT_TEMPLATES_ROOT=
# Optional owner-private author-kit cache; never pushed to Git.
MANUSCRIPT_PRIVATE_TEMPLATES_ROOT=
LATEX_DOCKER_EXECUTABLE=
# Immutable local verified document image ID (sha256:...), no implicit pull.
LATEX_COMPILER_IMAGE_ID=
LATEX_SCRATCH_ROOT=data/document-builds

# Generated uniquely by initialize_blank.py; set independently if configuring manually.
RESEARCHOS_DEPLOYMENT=compose
COMPOSE_PROJECT_NAME=researchos_blank
